# Example environment configuration
# Copy this file to .env and modify as needed

# Timezone for the guide data (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TVTV_TIMEZONE=America/New_York

# Your lineup ID, "{zipCode}_{headendId}" (guide data comes from the free
# Gracenote/Zap2it grid API). "OTA" is the sentinel for local broadcast.
# Examples: 85142_OTA, 85142_AZ02490, etc.
# You can specify multiple lineups using a comma-separated list via TVTV_LINEUPS
# Example: TVTV_LINEUPS=85142_OTA,85142_AZ02490
TVTV_LINEUP_ID=30236_OTA

# When multiple lineups are configured via TVTV_LINEUPS, this picks which one is
# served at "/" (must match one of TVTV_LINEUPS). If unset, "/" shows a list of
# lineups until one is picked at runtime via the "set as default" link on /list
# (that runtime pick is persisted and survives restarts).
# TVTV_DEFAULT_LINEUP=85142_OTA

# Number of days of guide data to fetch (1-14, max 14)
TVTV_DAYS=14

# How often to update the guide data (in seconds)
# 3600 = 1 hour, 7200 = 2 hours, 14400 = 4 hours, 43200 = 12 hours
TVTV_UPDATE_INTERVAL=43200

# Port to expose the HTTP server on
TVTV_PORT=8080

# Mock mode for local testing (set to true to use fixture data instead of real API)
# TVTV_MOCK_MODE=false
