# Example environment configuration for Gracenote/Zap2it XMLTV generator
# Copy this file to .env and modify as needed
# Note: Both GRACENOTE_* (preferred) and legacy TVTV_* variables are supported.

# Timezone for the guide data (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Default for 85142 (Queen Creek, AZ) is America/Phoenix
GRACENOTE_TIMEZONE=America/Phoenix

# Your lineup ID, "{zipCode}_{headendId}" (guide data comes from Gracenote/Zap2it API).
# "OTA" is the sentinel for local over-the-air broadcast.
# Examples: 85142_OTA, 85142_AZ02490, etc.
# You can specify multiple lineups using a comma-separated list via GRACENOTE_LINEUPS
# Example: GRACENOTE_LINEUPS=85142_OTA,85142_AZ02490
GRACENOTE_LINEUPS=85142_OTA

# Backwards-compatible single lineup variable (used if GRACENOTE_LINEUPS is unset)
GRACENOTE_LINEUP_ID=85142_OTA

# When multiple lineups are configured via GRACENOTE_LINEUPS, this picks which one is
# served at "/" (must match one of GRACENOTE_LINEUPS). If unset, "/" shows a list of
# lineups until one is picked at runtime via the "set as default" link on /list
# (that runtime pick is persisted and survives restarts).
GRACENOTE_DEFAULT_LINEUP=85142_OTA

# Number of days of guide data to fetch (1-14, max 14)
GRACENOTE_DAYS=8

# How often to update the guide data (in seconds)
# 3600 = 1 hour, 7200 = 2 hours, 14400 = 4 hours, 43200 = 12 hours
GRACENOTE_UPDATE_INTERVAL=3600

# Port to expose the HTTP server on
GRACENOTE_PORT=8080

# Mock mode for local testing (set to true to use fixture data instead of real API)
# GRACENOTE_MOCK_MODE=false
